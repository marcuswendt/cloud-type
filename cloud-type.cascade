{
  "version": "0.2",
  "metadata": {
    "name": "Cloud Type",
    "created": "2026-10-11T00:00:00.000Z",
    "modified": "2026-10-11T00:00:00.000Z"
  },
  "editor": {
    "id": "cloud-type",
    "title": "Cloud Type",
    "description": "Dotted cloud type, after cloud-plots' titletype: a headline or an image to plotter dots, with the book's focus and blown dots.",
    "groups": [
      "Input",
      "Focus",
      "Blown dots",
      "Dots",
      "Colour and page",
      "Export"
    ],
    "parameters": [
      {
        "id": "source",
        "node": "source-switch",
        "prop": "index",
        "label": "Source",
        "group": "Input",
        "control": "select",
        "options": [
          {
            "value": 0,
            "label": "Text"
          },
          {
            "value": 1,
            "label": "Image"
          }
        ],
        "order": 0
      },
      {
        "id": "seed",
        "node": "spec",
        "prop": "seed",
        "label": "Seed",
        "group": "Input",
        "control": "seed",
        "help": "A new seed: same look, new dots",
        "order": 1
      },
      {
        "id": "text",
        "node": "type-set",
        "prop": "text",
        "label": "Text",
        "group": "Input",
        "control": "textarea",
        "visibleWhen": {
          "param": "source",
          "equals": 0
        },
        "order": 2
      },
      {
        "id": "font",
        "node": "type-set",
        "prop": "font",
        "label": "Font",
        "group": "Input",
        "control": "file",
        "accept": [
          ".otf",
          ".ttf"
        ],
        "embed": "never",
        "visibleWhen": {
          "param": "source",
          "equals": 0
        },
        "help": "Drop in your licensed font to match the book. It is read here, in your browser, and never uploaded. Default: Inter Display Medium (OFL).",
        "order": 3
      },
      {
        "id": "capMm",
        "node": "spec",
        "prop": "capMm",
        "label": "Cap height",
        "group": "Input",
        "control": "slider",
        "min": 3,
        "max": 60,
        "step": 0.01,
        "unit": "mm",
        "help": "For an image source, the effect scale: the cap height the focus and blown dots are measured in",
        "order": 4
      },
      {
        "id": "leading",
        "node": "type-set",
        "prop": "leading",
        "label": "Leading",
        "group": "Input",
        "control": "slider",
        "min": 0.8,
        "max": 2,
        "step": 0.001,
        "unit": "cap",
        "visibleWhen": {
          "param": "source",
          "equals": 0
        },
        "order": 5
      },
      {
        "id": "tracking",
        "node": "type-set",
        "prop": "tracking",
        "label": "Tracking",
        "group": "Input",
        "control": "slider",
        "min": -0.2,
        "max": 0.4,
        "step": 0.0001,
        "unit": "cap",
        "visibleWhen": {
          "param": "source",
          "equals": 0
        },
        "order": 6
      },
      {
        "id": "width",
        "node": "type-set",
        "prop": "width",
        "label": "Width",
        "group": "Input",
        "control": "slider",
        "min": 0.6,
        "max": 1.4,
        "step": 0.01,
        "visibleWhen": {
          "param": "source",
          "equals": 0
        },
        "order": 7
      },
      {
        "id": "indents",
        "node": "type-set",
        "prop": "indents",
        "label": "Line indents",
        "group": "Input",
        "control": "text",
        "help": "e.g. 2.27, 0, 0 (caps)",
        "visibleWhen": {
          "param": "source",
          "equals": 0
        },
        "order": 8
      },
      {
        "id": "align",
        "node": "type-set",
        "prop": "align",
        "label": "Align",
        "group": "Input",
        "control": "select",
        "options": [
          {
            "value": "left",
            "label": "left"
          },
          {
            "value": "center",
            "label": "centre"
          },
          {
            "value": "right",
            "label": "right"
          }
        ],
        "visibleWhen": {
          "param": "source",
          "equals": 0
        },
        "order": 9
      },
      {
        "id": "image",
        "node": "image-mask",
        "prop": "image",
        "label": "Image",
        "group": "Input",
        "control": "file",
        "accept": [
          "image/*"
        ],
        "embed": "auto",
        "help": "Dark is ink.",
        "visibleWhen": {
          "param": "source",
          "equals": 1
        },
        "order": 10
      },
      {
        "id": "imageMode",
        "node": "image-mask",
        "prop": "mode",
        "label": "Image mode",
        "group": "Input",
        "control": "select",
        "options": [
          {
            "value": "threshold",
            "label": "Threshold"
          },
          {
            "value": "luminance",
            "label": "Luminance"
          }
        ],
        "visibleWhen": {
          "param": "source",
          "equals": 1
        },
        "order": 11
      },
      {
        "id": "threshold",
        "node": "image-mask",
        "prop": "threshold",
        "label": "Threshold",
        "group": "Input",
        "control": "slider",
        "min": 0.02,
        "max": 0.98,
        "step": 0.01,
        "visibleWhen": {
          "param": "source",
          "equals": 1
        },
        "order": 12
      },
      {
        "id": "floor",
        "node": "image-mask",
        "prop": "floor",
        "label": "Density floor",
        "group": "Input",
        "control": "slider",
        "min": 0,
        "max": 1,
        "step": 0.01,
        "visibleWhen": {
          "param": "imageMode",
          "equals": "luminance"
        },
        "order": 13
      },
      {
        "id": "invert",
        "node": "image-mask",
        "prop": "invert",
        "label": "Invert (light is ink)",
        "group": "Input",
        "control": "bool",
        "visibleWhen": {
          "param": "source",
          "equals": 1
        },
        "order": 14
      },
      {
        "id": "imageHeight",
        "node": "image-mask",
        "prop": "heightMm",
        "label": "Image height",
        "group": "Input",
        "control": "slider",
        "min": 5,
        "max": 250,
        "step": 0.5,
        "unit": "mm",
        "visibleWhen": {
          "param": "source",
          "equals": 1
        },
        "order": 15
      },
      {
        "id": "field",
        "node": "focus",
        "prop": "field",
        "label": "Style",
        "group": "Focus",
        "control": "select",
        "options": [
          {
            "value": "none",
            "label": "none (sharp)"
          },
          {
            "value": "radial",
            "label": "radial"
          },
          {
            "value": "tilt",
            "label": "tilt"
          },
          {
            "value": "swept",
            "label": "swept"
          },
          {
            "value": "hunt",
            "label": "hunt"
          }
        ],
        "order": 16
      },
      {
        "id": "useStrength",
        "node": "look",
        "prop": "useStrength",
        "label": "Use strength 1C→soft",
        "group": "Focus",
        "control": "bool",
        "help": "On: defocus, fade, sharp zone, falloff and dot tone follow the strength. Off: set them by hand.",
        "order": 17
      },
      {
        "id": "strength",
        "node": "look",
        "prop": "strength",
        "label": "Strength 1C→soft",
        "group": "Focus",
        "control": "slider",
        "min": 0,
        "max": 1,
        "step": 0.01,
        "visibleWhen": {
          "param": "useStrength",
          "equals": true
        },
        "help": "0 = 1C, 1 = soft; the approved CLOUD OBSERVATORY is 0.1. Sets defocus, fade, sharp zone, falloff and dot tone together.",
        "order": 18
      },
      {
        "id": "centre",
        "node": "focus",
        "prop": "centre",
        "label": "Focal point",
        "group": "Focus",
        "control": "vec2",
        "min": -0.5,
        "max": 3,
        "step": 0.001,
        "help": "x, y as a share of the text's box",
        "visibleWhen": {
          "param": "field",
          "in": [
            "radial",
            "tilt"
          ]
        },
        "order": 19
      },
      {
        "id": "angle",
        "node": "focus",
        "prop": "angle",
        "label": "Angle",
        "group": "Focus",
        "control": "slider",
        "min": -90,
        "max": 90,
        "step": 1,
        "unit": "°",
        "visibleWhen": {
          "param": "field",
          "equals": "tilt"
        },
        "order": 20
      },
      {
        "id": "sweep",
        "node": "focus",
        "prop": "sweep",
        "label": "Sweep",
        "group": "Focus",
        "control": "slider",
        "min": 0,
        "max": 1,
        "step": 0.01,
        "visibleWhen": {
          "param": "field",
          "equals": "swept"
        },
        "order": 21
      },
      {
        "id": "rhythm",
        "node": "focus",
        "prop": "rhythm",
        "label": "Rhythm",
        "group": "Focus",
        "control": "slider",
        "min": 0.5,
        "max": 8,
        "step": 0.1,
        "visibleWhen": {
          "param": "field",
          "equals": "hunt"
        },
        "order": 22
      },
      {
        "id": "dof",
        "node": "look",
        "prop": "dof",
        "label": "Sharp zone",
        "group": "Focus",
        "control": "slider",
        "min": 0,
        "max": 1,
        "step": 0.001,
        "help": "dof: share of the text's width kept sharp",
