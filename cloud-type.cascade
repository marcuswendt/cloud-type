    "outputs": [
      {
        "id": "png",
        "node": "png",
        "port": "image",
        "label": "Save PNG",
        "format": "png",
        "filename": "{scene}-{id}.png",
        "parameters": [
          "dpi",
          "pngGround"
        ]
      },
      {
        "id": "plot-svg",
        "node": "plot-svg",
        "port": "svg",
        "label": "Save plot SVG (mm, pen paths)",
        "format": "svg",
        "filename": "{scene}-plot.svg",
        "parameters": [
          "svgLayers"
        ]
      },
      {
        "id": "preview-svg",
        "node": "preview-svg",
        "port": "svg",
        "label": "Save preview SVG (filled)",
        "format": "svg",
        "filename": "{scene}-preview.svg",
        "view": true
      }
    ],
    "presets": [
      {
        "id": "co-approved",
        "label": "CLOUD OBSERVATORY · approved",
        "values": {
          "source": 0,
          "seed": 7,
          "text": "CLOUD\nOBSERVATORY",
          "capMm": 13.614,
          "leading": 1.2146,
          "tracking": -0.0097,
          "width": 1,
          "indents": "",
          "align": "left",
