        "prop": "angle",
        "label": "Direction",
        "group": "Blown dots",
        "control": "slider",
        "min": -180,
        "max": 180,
        "step": 1,
        "unit": "°",
        "help": "Where they travel: 0 right, 90 up. The book: 32 (wind from 238)",
        "order": 38
      },
      {
        "id": "blowDistance",
        "node": "blow",
        "prop": "distance",
        "label": "Distance",
        "group": "Blown dots",
        "control": "slider",
        "min": 0,
        "max": 3,
